# Ignore everything by default
*

# Keep repository metadata files
!.gitattributes
!.gitignore
!README.md
!LICENSE

# Keep the actual rebuild project files at repository root
!*.bas
!*.cls
!*.frm
!*.frx
!*.vbp
!*.vbw

# Keep the reconstructed DLL workspace as a whole folder
!DLL/
!DLL/**
!DLL_stub/
!DLL_stub/**
!tools/
!tools/**

# But still ignore Finder metadata inside it
DLL/.DS_Store
DLL/**/.DS_Store
DLL_stub/.DS_Store
DLL_stub/**/.DS_Store
tools/.DS_Store
tools/**/.DS_Store

# Keep the original vendor DLLs local-only
DLL_orig/
